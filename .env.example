# Required to enable the agent outside local development. Do not commit a real key.
SATURN_AGENT_ENABLED=false
SATURN_AGENT_ENDPOINT=https://llm.example.invalid
SATURN_AGENT_MODEL=
SATURN_AGENT_API_KEY_ENV=SATURN_AGENT_API_KEY
SATURN_AGENT_API_KEY=YOUR_API_KEY_HERE

# Optional provider and router overrides. TOML values remain the fallback.
SATURN_AGENT_TIMEOUT_SECONDS=30
SATURN_AGENT_MAX_COMPLETION_TOKENS=768
SATURN_AGENT_THINKING_ENABLED=false
SATURN_AGENT_MAX_CONCURRENT_REQUESTS=2
SATURN_AGENT_MAX_STEPS=5
SATURN_AGENT_MAX_TOOL_CALLS_PER_TURN=4
SATURN_AGENT_MAX_TOOL_CALLS=4
SATURN_AGENT_MAX_CALLS_PER_TOOL=2
SATURN_AGENT_MAX_TOOL_FAILURES=2
SATURN_AGENT_TOOL_TIMEOUT_MILLIS=10000
SATURN_AGENT_MAX_PROMPT_CHARS=8000
SATURN_AGENT_MAX_OUTPUT_CHARS=8000
SATURN_AGENT_MEMORY_TURNS=30
SATURN_AGENT_MEMORY_TTL_HOURS=168
SATURN_AGENT_MAX_RETRIES=2
SATURN_AGENT_RETRY_BACKOFF_MILLIS=250

# Optional dynamic-SQL bounds for authorized callers.
SATURN_AGENT_DYNAMIC_SQL_ENABLED=true
SATURN_AGENT_DYNAMIC_SQL_MAX_SQL_CHARS=4000
SATURN_AGENT_DYNAMIC_SQL_MAX_ROWS=50
SATURN_AGENT_DYNAMIC_SQL_MAX_COLUMNS=32
SATURN_AGENT_DYNAMIC_SQL_MAX_CELL_CHARS=2000
SATURN_AGENT_DYNAMIC_SQL_MAX_RESULT_CHARS=32000
SATURN_AGENT_DYNAMIC_SQL_TIMEOUT_MILLIS=1000
